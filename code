import tkinter as tk
from tkinter import messagebox, ttk
import csv
from datetime import datetime
import os

# Install fpdf if not installed
try:
    from fpdf import FPDF
except ImportError:
    os.system("pip install fpdf")
    from fpdf import FPDF

FILENAME = 'attendance.csv'

# Create CSV file if it doesn't exist
if not os.path.exists(FILENAME):
    with open(FILENAME, 'w', newline='') as f:
        writer = csv.writer(f)
        writer.writerow(["Register No", "Name", "Date & Time"])

# Check if attendance is already marked today
def is_already_marked(reg_no):
    today = datetime.now().strftime("%Y-%m-%d")
    with open(FILENAME, 'r') as file:
        reader = csv.reader(file)
        next(reader)  # Skip header
        for row in reader:
            if row[0] == reg_no and row[2].startswith(today):
                return True
    return False

# Mark attendance
def mark_attendance(name_entry, reg_entry):
    name = name_entry.get().strip()
    reg = reg_entry.get().strip()

    if not name or not reg:
        messagebox.showerror("Missing Info", "Please enter Name and Register Number.")
        return

    if is_already_marked(reg):
        messagebox.showinfo("Already Marked", f"{reg} has already marked attendance today.")
        return

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(FILENAME, 'a', newline='') as f:
        writer = csv.writer(f)
        writer.writerow([reg, name, now])

    messagebox.showinfo("Success", f"Marked: {name} ({reg}) at {now}")
    name_entry.delete(0, tk.END)
    reg_entry.delete(0, tk.END)

# Export attendance to PDF
def export_to_pdf():
    today = datetime.now().strftime("%Y-%m-%d")
    pdf = FPDF()
    pdf.add_page()
    pdf.set_font("Arial", size=12)
    pdf.cell(200, 10, f"Attendance Report - {today}", ln=True, align='C')
    pdf.ln(10)

    with open(FILENAME, 'r') as file:
        reader = csv.reader(file)
        next(reader)
        for row in reader:
            if row[2].startswith(today):
                pdf.cell(200, 10, f"{row[0]} - {row[1]} - {row[2]}", ln=True)

    filename = f"attendance_{today}.pdf"
    pdf.output(filename)
    messagebox.showinfo("Exported", f"PDF saved as {filename}")

# View today's attendance
def view_attendance():
    top = tk.Toplevel()
    top.title("Today's Attendance")
    top.geometry("500x400")

    tree = ttk.Treeview(top, columns=("reg", "name", "time"), show="headings")
    tree.heading("reg", text="Register No")
    tree.heading("name", text="Name")
    tree.heading("time", text="Date & Time")
    tree.pack(fill=tk.BOTH, expand=True)

    today = datetime.now().strftime("%Y-%m-%d")
    with open(FILENAME, 'r') as file:
        reader = csv.reader(file)
        next(reader)
        for row in reader:
            if row[2].startswith(today):
                tree.insert('', 'end', values=row)

# Clock display
def update_clock(label):
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    label.config(text=now)
    label.after(1000, update_clock, label)

# Main attendance window
def show_main_window():
    root = tk.Tk()
    root.title("Attendance System")
    root.geometry("500x580")
    root.configure(bg="#F2F5F7")

    tk.Label(root, text="CMR University", font=("Helvetica", 20, "bold"), bg="#F2F5F7", fg="#2C3E50").pack(pady=10)
    tk.Label(root, text="Attendance Management System", font=("Helvetica", 14), bg="#F2F5F7", fg="#34495E").pack()

    clock = tk.Label(root, font=("Helvetica", 10), bg="#F2F5F7", fg="#34495E")
    clock.pack(pady=5)
    update_clock(clock)

    form = tk.Frame(root, bg="#F2F5F7")
    form.pack(pady=20)

    tk.Label(form, text="Name:", font=("Helvetica", 12), bg="#F2F5F7", fg="#34495E").grid(row=0, column=0, pady=10, sticky="e")
    name_entry = tk.Entry(form, font=("Helvetica", 12), width=30, bg="#FFFFFF", fg="#2C3E50", relief=tk.FLAT)
    name_entry.grid(row=0, column=1, pady=10)

    tk.Label(form, text="Register No:", font=("Helvetica", 12), bg="#F2F5F7", fg="#34495E").grid(row=1, column=0, pady=10, sticky="e")
    reg_entry = tk.Entry(form, font=("Helvetica", 12), width=30, bg="#FFFFFF", fg="#2C3E50", relief=tk.FLAT)
    reg_entry.grid(row=1, column=1, pady=10)

    btn_frame = tk.Frame(root, bg="#F2F5F7")
    btn_frame.pack(pady=10)

    tk.Button(btn_frame, text="Mark Attendance", font=("Helvetica", 11, "bold"),
              bg="#2980B9", fg="white", relief="flat", padx=10, pady=5,
              command=lambda: mark_attendance(name_entry, reg_entry)).grid(row=0, column=0, padx=10)

    tk.Button(btn_frame, text="Clear", font=("Helvetica", 11, "bold"),
              bg="#E74C3C", fg="white", relief="flat", padx=10, pady=5,
              command=lambda: (name_entry.delete(0, tk.END), reg_entry.delete(0, tk.END))).grid(row=0, column=1, padx=10)

    tk.Button(root, text="View Today's Attendance", font=("Helvetica", 11, "bold"),
              bg="#2980B9", fg="white", relief="flat", padx=10, pady=5,
              command=view_attendance).pack(pady=5)

    tk.Button(root, text="Export to PDF", font=("Helvetica", 11, "bold"),
              bg="#8E44AD", fg="white", relief="flat", padx=10, pady=5,
              command=export_to_pdf).pack(pady=5)

    root.mainloop()

# Admin login window
def login_screen():
    login = tk.Tk()
    login.title("Admin Login")
    login.geometry("300x220")
    login.configure(bg="#F2F5F7")

    tk.Label(login, text="Admin Login", font=("Helvetica", 16, "bold"), bg="#F2F5F7", fg="#2C3E50").pack(pady=10)

    tk.Label(login, text="Username:", bg="#F2F5F7", fg="#34495E").pack()
    username = tk.Entry(login)
    username.pack(pady=5)

    tk.Label(login, text="Password:", bg="#F2F5F7", fg="#34495E").pack()
    password = tk.Entry(login, show="*")
    password.pack(pady=5)

    def check_login():
        if username.get() == "admin" and password.get() == "1234":
            login.destroy()
            show_main_window()
        else:
            messagebox.showerror("Login Failed", "Incorrect username or password.")

    tk.Button(login, text="Login", command=check_login, bg="#2980B9", fg="white", font=("Helvetica", 11, "bold"),
              relief="flat", padx=10, pady=5).pack(pady=10)

    login.mainloop()

# Entry point
if __name__ == "__main__":
    login_screen()
